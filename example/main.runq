extern fn myCFunc(i32 num) : i32;
extern fn factorialC(i32 num) : i32;
extern fn addOne(i32 num) : i32;
extern fn putc(char c) : char;
extern fn getc() : char;
extern fn newLn() : char;
extern fn castDigitToChar(i32 digit) : char;
extern fn putI32(i32 num) : i32;
extern fn getDigit() : i32;

fn isPositive(i32 num) : bool {
    return num > 0;
}

fn sayRunq() : i32 {
    putc('R'); putc('u'); putc('n'); putc('Q'); newLn();

    putc(castDigitToChar(6));
    newLn();
    putI32(12367);
    newLn();
    // putI32(getDigit()); this works as well
    putc(getc());
    newLn();

    return 0;
}

entry main() {
    let i32 value1 = myCFunc(6);
    let i32 value2 = addOne(factorialC(5));

    sayRunq();

    return value1 + value2 + example();
}