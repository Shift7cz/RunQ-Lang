fn countDigitsDec(i32 n) : i32 { // todo: will fail for negative
    let~ i32 num = n;
    if num == 0 {
        return 1;
    }
    let~ i32 count = 0;
    while num > 0 {
        num = num / 10;
        count = count + 1;
    }
    return count;
}

fn castDigitToChar(i32 digit) : char {
    if digit == 0 { return '0'; }
    if digit == 1 { return '1'; }
    if digit == 2 { return '2'; }
    if digit == 3 { return '3'; }
    if digit == 4 { return '4'; }
    if digit == 5 { return '5'; }
    if digit == 6 { return '6'; }
    if digit == 7 { return '7'; }
    if digit == 8 { return '8'; }
    if digit == 9 { return '9'; }
    return '_'; // error
}

fn castCharToDigit(char c) : i32 {
    if c == '0' { return 0; }
    if c == '1' { return 1; }
    if c == '2' { return 2; }
    if c == '3' { return 3; }
    if c == '4' { return 4; }
    if c == '5' { return 5; }
    if c == '6' { return 6; }
    if c == '7' { return 7; }
    if c == '8' { return 8; }
    if c == '9' { return 9; }
    return 0; // error
}