// --- External C & Library declarations ---
extern fn factorialC(i32 num) : i32;
extern fn addOne(i32 value) : i32;

entry main() {
    let i32 cVal = factorialC(5);   // C interop: 120
    let i32 libVal = addOne(cVal);  // Library call: 121

    let~ i24 custom = 400i24;       // Arbitrary signed integer (i24)
    custom = custom + 20i24;        // Mutable variable: 420

    let~ u5 small = 25u5;           // Arbitrary unsigned integer (u5)
    small = small + 6u5;            // Max value: 31u5

    showcase(libVal);

    return 0;
}
