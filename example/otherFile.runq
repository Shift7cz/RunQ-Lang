// --- Stdlib terminal I/O ---
extern fn putc(char c) : char;
extern fn getc() : char;
extern fn newLn() : char;
extern fn putI32(i32 num) : i32;

// Prints a divider line using an underscore loop and void return
fn printDivider() : void {
    let~ i32 i = 0;
    while i < 30 {
        putc('_');
        i = i + 1;
    }
    newLn();
}

// Showcases explicit early return in a void function
fn testVoid(bool shouldReturnEarly) : void {
    if shouldReturnEarly {
        return;
    }
    putc('F'); putc('A'); putc('I'); putc('L');
    newLn();
}

// Computes sum of 1..n using a while loop
fn sumUpTo(i32 n) : i32 {
    let~ i32 sum = 0;
    let~ i32 current = 1;
    while current <= n {
        sum = sum + current;
        current = current + 1;
    }
    return sum;
}

// Showcases arbitrary-width signed (i24) and unsigned (u5) integer operations
fn testInts() : bool {
    let~ i24 signedVal = 400i24;
    signedVal = signedVal + 20i24;

    let~ u5 unsignedVal = 20u5;
    unsignedVal = unsignedVal + 11u5; // 31u5 (max value for u5)

    if signedVal == 420i24 {
        if unsignedVal == 31u5 {
            return true;
        }
    }
    return false;
}

// Showcases terminal input from stdlib (getc)
fn testInput() : void {
    putc('K'); putc('e'); putc('y');
    newLn();

    let char inputChar = getc();

    putc('G'); putc('o'); putc('t');
    newLn();
    putc(inputChar);
    newLn();
}

// Main showcase runner
fn showcase(i32 libResult) : void {
    printDivider();

    // Title: "RunQ Showcase"
    putc('R'); putc('u'); putc('n'); putc('Q');
    newLn();
    printDivider();

    // 1. While loop calculation (1..10 = 55)
    putc('1'); putc('_');
    putc('S'); putc('u'); putc('m');
    newLn();
    putI32(sumUpTo(10));
    newLn();

    // 2. Result from C factorial + library addOne (120 + 1 = 121)
    putc('2'); putc('_');
    putc('C'); putc('L'); putc('i'); putc('b');
    newLn();
    putI32(libResult);
    newLn();

    // 3. Arbitrary signed (i24) and unsigned (u5) types test
    putc('3'); putc('_');
    putc('T'); putc('y'); putc('p'); putc('e'); putc('s');
    newLn();
    if testInts() {
        putc('O'); putc('K');
    } else {
        putc('E'); putc('R'); putc('R');
    }
    newLn();

    // 4. Void function & early return test
    putc('4'); putc('_');
    putc('V'); putc('o'); putc('i'); putc('d');
    newLn();
    testVoid(true);
    putc('O'); putc('K');
    newLn();

    // 5. Interactive input test
    putc('5'); putc('_');
    putc('I'); putc('n'); putc('p'); putc('u'); putc('t');
    newLn();
    testInput();

    printDivider();
}
